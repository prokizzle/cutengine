{
  "expo": {
    "name": "CutEngine",
    "slug": "cutengine",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "cutengine",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.feelingmindful.diet-plan"
    },
    "plugins": [
      "expo-router",
      "@sentry/react-native/expo",
      [
        "expo-health",
        {
          "isClinicalDataEnabled": true,
          "healthSharePermission": "CutEngine reads your weight, active energy, and body metrics to compute your daily calorie target.",
          "healthUpdatePermission": "CutEngine writes your body mass to Apple Health."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCanary": true
    }
  }
}
