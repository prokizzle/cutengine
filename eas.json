{
  "cli": {
    "version": ">= 14.0.0"
  },
  "build": {
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "image": "latest"
      },
      "env": {
        "APP_VARIANT": "production"
      }
    },
    "internal": {
      "channel": "internal",
      "distribution": "internal",
      "autoIncrement": true,
      "ios": {
        "image": "latest"
      },
      "env": {
        "APP_VARIANT": "production"
      }
    },
    "sideload": {
      "channel": "sideload",
      "distribution": "internal",
      "autoIncrement": true,
      "ios": {
        "image": "latest"
      },
      "env": {
        "APP_VARIANT": "sideload"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "nick@feelingmindful.com"
      }
    }
  }
}
