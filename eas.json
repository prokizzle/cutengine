{
  "cli": {
    "version": ">= 14.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "ios": {
        "image": "latest"
      },
      "env": {
        "APP_VARIANT": "production",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "internal": {
      "channel": "internal",
      "distribution": "internal",
      "autoIncrement": true,
      "ios": {
        "image": "latest"
      },
      "env": {
        "APP_VARIANT": "production",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "sideload": {
      "channel": "sideload",
      "distribution": "internal",
      "autoIncrement": true,
      "ios": {
        "image": "latest"
      },
      "env": {
        "APP_VARIANT": "sideload",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "nick@feelingmindful.com",
        "ascAppId": "6757690403",
        "appleTeamId": "W4MZM2YEAU"
      }
    }
  }
}
