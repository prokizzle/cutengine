{
  "name": "cutengine",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@sentry/react-native": "^8.13.0",
    "expo": "~56.0.12",
    "expo-constants": "~56.0.18",
    "expo-dev-client": "~56.0.20",
    "expo-health": "^0.0.0",
    "expo-linking": "~56.0.14",
    "expo-router": "~56.2.11",
    "expo-status-bar": "~56.0.4",
    "expo-updates": "~56.0.19",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-edge-to-edge": "^1.8.1",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-purchases": "^10.2.2",
    "react-native-purchases-ui": "^10.2.2",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-unistyles": "3.2.5",
    "react-native-worklets": "0.8.3",
    "reselect": "^5.2.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^12",
    "@types/jest": "^29",
    "@types/react": "~19.2.2",
    "jest": "^29",
    "jest-expo": "^56.0.5",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@sentry/react-native|native-base|react-native-svg)"
    ]
  },
  "scripts": {
    "test": "jest",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "tsc --noEmit",
    "format": "prettier --write .",
    "build:prod": "eas build --profile production --platform ios",
    "build:internal": "eas build --profile internal --platform ios",
    "build:sideload": "eas build --profile sideload --platform ios",
    "verify:seed": "bash scripts/verify-seed-strip.sh"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": ["@sentry/react-native"]
    }
  }
}
